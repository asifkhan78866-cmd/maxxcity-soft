# ═══════════════════════════════════════
# MaxxCity Mall Management System
# Environment Variables
# ═══════════════════════════════════════
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# SECURITY NOTE: this file previously contained live Supabase keys, including
# a SERVICE ROLE key. Those keys must be treated as compromised — rotate them
# in the Supabase dashboard (Settings → API → Reset) before going live.

# ─── Supabase ─────────────────────────────────────────────
# The anon key may reach the browser. RLS denies it every business table, so
# the app reads and writes exclusively through server route handlers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses row level security. Never prefix with NEXT_PUBLIC_,
# never reference from a client component, never paste into a browser console.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Session signing (REQUIRED) ───────────────────────────
# Signs the auth cookie. Without it, in production the app refuses every
# session rather than falling back to a guessable default.
# Generate:  openssl rand -base64 48
SESSION_SECRET=generate-a-long-random-value-at-least-32-characters

# ─── First-admin bootstrap (temporary) ────────────────────
# Enables POST /api/auth/bootstrap to create the FIRST admin account, and only
# while no active admin exists. Remove this line once that account is created.
# Generate:  openssl rand -hex 24
# BOOTSTRAP_TOKEN=

# ─── AI services (optional) ───────────────────────────────
# Without these the AI screens report that the feature is unconfigured. They
# never fall back to invented figures.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ─── Store identity ───────────────────────────────────────
NEXT_PUBLIC_STORE_NAME=MaxxCity Mall
NEXT_PUBLIC_STORE_ADDRESS=Ramnagar Main Road
NEXT_PUBLIC_STORE_CITY=Adilabad, Telangana 504001
NEXT_PUBLIC_STORE_PHONE=9100770398
# Leave blank until the real GSTIN is issued — receipts omit the line rather
# than printing a placeholder that would be legally misleading.
NEXT_PUBLIC_STORE_GSTIN=
NEXT_PUBLIC_STORE_UPI_ID=

# ─── Terminal identity ────────────────────────────────────
# Set a DISTINCT value on each POS machine. It namespaces offline invoice
# numbers so two counters billing during an outage cannot collide.
# When unset, a stable per-browser id is generated and stored locally.
NEXT_PUBLIC_TERMINAL_ID=

# ─── Finance / EMI ────────────────────────────────────────
# The finance-case booking fee. INDEPENDENT of the ₹99 product selling price —
# changing one must never change the other.
NEXT_PUBLIC_EMI_BOOKING_FEE=199

# ─── Payment provider (not yet integrated) ────────────────
# Present for future use. The POS currently records the CASHIER'S confirmation
# for UPI and card, and says so on screen. Do not add keys expecting automatic
# verification until the server-side verification flow is built.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ─── Operational flags ────────────────────────────────────
# Allows POST /api/seed to insert demo catalogue rows in production.
# Leave unset. Demo data in a live store corrupts every report.
# ALLOW_SEED=false
