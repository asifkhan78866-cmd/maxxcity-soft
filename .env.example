# ════════════════════════════════════════════════════════════
# MAXXCITY MART POS — Environment Variables
# ════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in real values:
#
#     cp .env.example .env.local
#
# .env.local is gitignored and must NEVER be committed.
# Every value below is a placeholder — the app refuses to start if a
# placeholder is left in place for a required variable.
#
# Full walkthrough of where each value comes from: docs/ENV_SETUP.md
#
# Legend
#   [REQUIRED]  the app will not start without it
#   [OPTIONAL]  has a safe default, or disables one feature when absent
#   [PUBLIC]    inlined into the browser bundle — assume the world can read it
#   [SECRET]    server-only — must never appear in client code or in git
# ════════════════════════════════════════════════════════════


# ─── Supabase: safe browser/client configuration ─────────────
# [REQUIRED] [PUBLIC]
# Project URL and the anonymous key. Both are shipped to the browser by
# design. Row level security denies the anon key every business table, so
# on its own it cannot read your data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key


# ─── Supabase: SERVER ONLY ───────────────────────────────────
# [REQUIRED] [SECRET]
# Bypasses row level security completely. Anyone holding this key has full
# read/write access to every table. Never prefix it with NEXT_PUBLIC_, never
# reference it from a client component, never paste it into a browser console.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-or-secret-key


# ─── Supabase PostgreSQL: SERVER/CLI ONLY ────────────────────
# [OPTIONAL] [SECRET]
# Direct database connection, used ONLY by ./scripts/apply-migrations.sh.
# The running application never reads this. It contains your database
# password in plain text.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres


# ─── Session signing ─────────────────────────────────────────
# [REQUIRED in production] [SECRET]
# Signs the authentication cookie. Without it, in production the app refuses
# every session rather than falling back to a guessable default — which would
# let anyone forge an admin session.
#   Generate:  openssl rand -base64 48
SESSION_SECRET=generate-a-long-random-value-at-least-32-characters


# ─── First-admin bootstrap (temporary) ───────────────────────
# [OPTIONAL] [SECRET]
# Enables POST /api/auth/bootstrap to create the FIRST admin account, and only
# while no active admin exists. Delete this line once that account is created.
#   Generate:  openssl rand -hex 24
# BOOTSTRAP_TOKEN=


# ─── AI services ─────────────────────────────────────────────
# [OPTIONAL] [SECRET]
# Without these the AI screens report that the feature is unconfigured. They
# never fall back to invented figures.
#   GROQ_API_KEY        powers the "Ask" assistant
#   OPENROUTER_API_KEY  powers weekly insights and inventory commentary
GROQ_API_KEY=
OPENROUTER_API_KEY=


# ─── Store identity ──────────────────────────────────────────
# [OPTIONAL] [PUBLIC]
# Printed on receipts and invoices. All have defaults.
NEXT_PUBLIC_STORE_NAME=MaxxCity Mall
NEXT_PUBLIC_STORE_ADDRESS=Ramnagar Main Road
NEXT_PUBLIC_STORE_CITY=Adilabad, Telangana 504001
NEXT_PUBLIC_STORE_PHONE=9100770398

# Leave blank until a real GSTIN is issued. Receipts omit the line entirely
# rather than printing a placeholder, which would be legally misleading.
NEXT_PUBLIC_STORE_GSTIN=

# Shown on the UPI payment panel.
NEXT_PUBLIC_STORE_UPI_ID=


# ─── Terminal identity ───────────────────────────────────────
# [OPTIONAL] [PUBLIC]
# Set a DISTINCT value on each POS machine. It namespaces offline invoice
# numbers so two counters billing during an outage cannot collide.
# When left blank, a stable per-browser id is generated and stored locally.
NEXT_PUBLIC_TERMINAL_ID=


# ─── Finance / EMI ───────────────────────────────────────────
# [OPTIONAL] [PUBLIC]
# The finance-case booking fee. INDEPENDENT of the ₹99 product selling price —
# changing one must never change the other.
NEXT_PUBLIC_EMI_BOOKING_FEE=199


# ─── Operational flags ───────────────────────────────────────
# [OPTIONAL] [SECRET]
# Allows POST /api/seed to insert demo catalogue rows in production.
# Leave unset. Demo data in a live store corrupts every report.
# ALLOW_SEED=false
